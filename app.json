{
  "expo": {
    "name": "CashRunway",
    "slug": "cashrunway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cashrunway",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.creez.cashrunway",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.creez.cashrunway"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/reminder.wav"
          ],
          "defaultChannel": "cashrunway-reminders"
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "ic_quick_expense": {
              "foregroundImage": "./assets/images/quick-expense.png",
              "backgroundColor": "#FFFFFF"
            },
            "ic_quick_income": {
              "foregroundImage": "./assets/images/quick-income.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b764167-4838-4d98-9a96-56b2e67f05e0"
      }
    }
  }
}
